DATABASE_URL="file:./dev.db"
OTA_ADMIN_API_KEY="replace-with-a-strong-secret"
PORT=3000

# Firebase Admin SDK service account, as a single-line JSON string.
# Get this from Firebase console -> Project settings -> Service accounts ->
# Generate new private key, then minify the downloaded JSON file to one line
# (e.g. `node -e "console.log(JSON.stringify(require('./path/to/key.json')))"`).
# NEVER commit the actual key file itself.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","...":"..."}'
